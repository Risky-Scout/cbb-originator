# --- secrets (never commit) ---
.env
.env.*
*.key
secrets*
# --- local environments / caches ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
# --- generated data stores (rebuildable from immutable inputs; too large for git) ---
data/raw/
data/canonical/
data/staging/
*.duckdb
*.duckdb.wal
*.duckdb.building
# large generated QA payloads (regenerated by the build; compact QA reports stay tracked)
data/qa/unresolved_identities.csv
data/qa/starter_pack_inventory.csv
data/qa/starter_pack_inventory.json
data/qa/large/
# --- OS / editor metadata ---
.DS_Store
~$*
data/duckdb_tmp/
# Stage 3 generated stores (rebuildable deterministically from v2.2 + code)
modeling/store/
modeling/features/
modeling/labels/*/
# 2025-26 lockbox generated stores (rebuildable from the preserved raw payloads; compact build records stay tracked)
data/lockbox_2025_26/*/parquet/

# V2 out-of-sample forecast store (large; sha256 + counts tracked in modeling/player_props_v2/oos_forecast_store_manifest.json)
modeling/v2_oos/
