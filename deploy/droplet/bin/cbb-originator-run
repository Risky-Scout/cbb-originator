#!/usr/bin/env bash
# CBB Originator: the ONLY entrypoint the Droplet systemd units call (deploy/droplet/systemd/*.service).
# docs/operations/CBB_DROPLET_DEPLOYMENT_PACKAGE.md.
#
#   cbb-originator-run preflight                safety + identity checks only (no lock, no model work)
#   cbb-originator-run lifecycle-morning        07:00 ET (prod/lifecycle.py morning): settlement, prior-day Grades,
#                                               walk-forward (shared heavy lock held for THAT STEP ONLY, wait <= 30 min;
#                                               busy -> DEFERRED_SHARED_LOCK, last-known-good kept), INITIAL forecast,
#                                               exports, health report. CBB writer lock for the whole job.
#   cbb-originator-run refit-retry              08:00 ET: no-op unless 07:00 recorded DEFERRED_SHARED_LOCK (writer lock)
#   cbb-originator-run lifecycle-refresh HH:MM  10:00 / 13:00 / 16:00 / 18:00 ET availability refresh (writer lock)
#   cbb-originator-run tick                     every 10 min (writer lock): official shadow tick only when its cheap due
#                                               gate says due; then the tiered quote refresh (per-game tier spacing;
#                                               nothing requested when no game is due; reprice only, never a refit)
#   CBB_DRY_RUN=1 ...                           run every check, print the command that would run, run nothing
#
# Layout (immutable code, mutable state elsewhere):
#   CBB_APP_ROOT   /opt/sports-models/cbb-originator/current -> releases/<sha>   (root-owned, read-only)
#   release manifest  /opt/sports-models/cbb-originator/releases/<sha>.sha256sums (root-owned; written at deploy from
#                     the exact git tree of <sha>; every file is re-verified before any job)
#   CBB_PROD_ROOT  /var/lib/sports-models/cbb-originator/prod  (ops tree, state, ledgers, runs, cache, health)
#   CBB_WF_ROOT    /var/lib/sports-models/cbb-originator/walkforward
#   CBB_EXPORT_ROOT /var/lib/sports-models/cbb-originator/exports/<YYYY-MM-DD>/
# A git checkout (CBB_APP_ROOT/.git present) is verified with git instead (development / tests).
#
# Exit codes: 0 ok | 1 job failed | 3 unsafe or invalid configuration (refused) | 4 this host is not the designated
#             writer | 75 CBB writer lock unavailable (EX_TEMPFAIL)
# Never prints secret values: only variable NAMES are ever reported.
set -euo pipefail

CMD="${1:-}"
APP="${CBB_APP_ROOT:-${CBB_APP_DIR:-/opt/sports-models/cbb-originator/current}}"
VENV="${CBB_VENV_DIR:-/opt/sports-models/cbb-originator/venv}"
STATE="${CBB_STATE_ROOT:-/var/lib/sports-models/cbb-originator}"
export CBB_PROD_ROOT="${CBB_PROD_ROOT:-$STATE/prod}"
export CBB_WF_ROOT="${CBB_WF_ROOT:-$STATE/walkforward}"
export CBB_EXPORT_ROOT="${CBB_EXPORT_ROOT:-$STATE/exports}"
LOCK_DIR="${CBB_LOCK_DIR:-$STATE/locks}"
WRITER_LOCK="$LOCK_DIR/cbb-originator.writer.lock"
export CBB_HEAVY_LOCK="${CBB_HEAVY_LOCK:-/run/lock/sports-models/heavy.lock}"
export CBB_HEAVY_LOCK_WAIT_SEC="${CBB_HEAVY_LOCK_WAIT_SEC:-1800}"
WRITER_WAIT_SEC="${CBB_WRITER_LOCK_WAIT_SEC:-600}"
DRY="${CBB_DRY_RUN:-0}"

log() { echo "cbb-originator-run[$CMD]: $*" >&2; }
refuse() { log "REFUSED: $*"; exit 3; }

case "$CMD" in preflight|lifecycle-morning|refit-retry|tick) ;;
  lifecycle-refresh) case "${2:-}" in 10:00|13:00|16:00|18:00) ;; *) echo "lifecycle-refresh needs one of 10:00 13:00 16:00 18:00" >&2; exit 3 ;; esac ;;
  *) echo "usage: cbb-originator-run preflight|lifecycle-morning|refit-retry|lifecycle-refresh HH:MM|tick" >&2; exit 3 ;; esac

# ------------------------------------------------------------------ 1. safe-by-default deployment mode (docs §10)
[ "${CBB_MODEL_SOURCE:-ACTIVE_DAILY}" = "ACTIVE_DAILY" ] || [ "${CBB_MODEL_SOURCE}" = "FROZEN_OPENING_BASELINE" ] \
  || refuse "CBB_MODEL_SOURCE=${CBB_MODEL_SOURCE} (ACTIVE_DAILY | FROZEN_OPENING_BASELINE)"
case "${ROTOWIRE_ENABLED:-false}" in
  false) ;;
  true) refuse "ROTOWIRE_ENABLED=true: RotoWire is HARD_DISABLED_NO_KEY on this deployment" ;;
  *) refuse "ROTOWIRE_ENABLED must be true|false" ;;
esac
[ "${WIZARDOFODDS_PUBLICATION:-disabled}" = "disabled" ] || refuse "WIZARDOFODDS_PUBLICATION must be disabled"
[ "${AUTOMATIC_WAGERING:-disabled}" = "disabled" ] || refuse "AUTOMATIC_WAGERING must be disabled"
[ "${REAL_MONEY_ACTIONABILITY:-disabled}" = "disabled" ] || refuse "REAL_MONEY_ACTIONABILITY must be disabled"
for v in OMP_NUM_THREADS OPENBLAS_NUM_THREADS MKL_NUM_THREADS VECLIB_MAXIMUM_THREADS NUMEXPR_NUM_THREADS; do
  [ "${!v:-}" = "1" ] || refuse "$v must be 1 (walkforward/config.THREAD_ENV)"
done
[ "${CBB_DUCKDB_THREADS:-1}" = "1" ] || refuse "CBB_DUCKDB_THREADS must be 1 on the shared Droplet"
export CBB_DUCKDB_THREADS=1
# DuckDB memory cap + spill (cbb_platform/duckdb_limits.py): resource settings only; the spill dir must be CBB state
export CBB_DUCKDB_MEMORY_LIMIT="${CBB_DUCKDB_MEMORY_LIMIT:-700MB}"
export CBB_DUCKDB_TEMP_DIR="${CBB_DUCKDB_TEMP_DIR:-$STATE/staging/tmp/duckdb}"
case "$CBB_DUCKDB_TEMP_DIR/" in "$STATE"/*) ;; *) refuse "CBB_DUCKDB_TEMP_DIR must be inside $STATE" ;; esac

# ------------------------------------------------------------------ 2. exact verified code identity
[ -n "${CBB_EXPECTED_COMMIT:-}" ] || refuse "CBB_EXPECTED_COMMIT is not set"
REL=""
if [ -e "$APP/.git" ]; then
  HEAD_SHA="$(git -C "$APP" rev-parse HEAD 2>/dev/null || true)"
  [ "$HEAD_SHA" = "$CBB_EXPECTED_COMMIT" ] || refuse "app checkout is at '${HEAD_SHA:-none}', expected $CBB_EXPECTED_COMMIT"
  [ -z "$(git -C "$APP" status --porcelain 2>/dev/null)" ] || refuse "app checkout has local modifications"
else
  REL="$(readlink -f "$APP" 2>/dev/null || true)"
  [ -n "$REL" ] && [ -d "$REL" ] || refuse "application root $APP does not resolve to a release directory"
  HEAD_SHA="$(basename "$REL")"
  [ "$HEAD_SHA" = "$CBB_EXPECTED_COMMIT" ] || refuse "release is '$HEAD_SHA', expected $CBB_EXPECTED_COMMIT"
  MAN="${CBB_RELEASE_MANIFEST:-$REL.sha256sums}"
  [ -f "$MAN" ] || refuse "release manifest $MAN is absent"
  (cd "$REL" && sha256sum --quiet --strict -c "$MAN" >/dev/null 2>&1) || refuse "release $HEAD_SHA differs from its manifest"
  [ "$(cd "$REL" && find . -type f | wc -l)" = "$(wc -l < "$MAN")" ] || refuse "release $HEAD_SHA holds files outside its manifest"
fi
export CBB_CODE_COMMIT="$HEAD_SHA"
case "$CBB_PROD_ROOT/" in "$APP"/*|"${REL:-$APP}"/*) refuse "CBB_PROD_ROOT is inside the application tree" ;; esac

# ------------------------------------------------------------------ 3. single-writer role (scheduler cutover)
if [ "$CMD" != "preflight" ] && [ "${CBB_SCHEDULER_ROLE:-DISABLED}" != "PRIMARY_WRITER" ]; then
  log "CBB_SCHEDULER_ROLE=${CBB_SCHEDULER_ROLE:-DISABLED}: this host is not the designated ops-state writer; nothing run"
  exit 4
fi

PY="$VENV/bin/python"
cd "$APP"
export PYTHONPATH="$APP" PYTHONDONTWRITEBYTECODE=1
OPS="$CBB_PROD_ROOT/ops"
mem_available_mb() { awk '/^MemAvailable:/ {printf "%.0f", $2 / 1024}' "${CBB_MEMINFO:-/proc/meminfo}"; }

if [ "$CMD" = "preflight" ]; then
  log "PREFLIGHT OK: commit $HEAD_SHA; prod root $CBB_PROD_ROOT; MemAvailable $(mem_available_mb) MB; history ${CBB_HISTORY_SOURCE:-CONTROL}; rotowire/publication/wagering disabled"
  exit 0
fi

case "$CMD" in
  lifecycle-morning) RUN=("$PY" -m cbb_platform.prod.lifecycle --ops-root "$OPS" --prod-root "$CBB_PROD_ROOT" morning) ;;
  refit-retry)       RUN=("$PY" -m cbb_platform.prod.lifecycle --ops-root "$OPS" --prod-root "$CBB_PROD_ROOT" refit-retry) ;;
  lifecycle-refresh) RUN=("$PY" -m cbb_platform.prod.lifecycle --ops-root "$OPS" --prod-root "$CBB_PROD_ROOT" refresh --window "$2") ;;
  tick)              RUN=("$PY" -m cbb_platform.prod.shadow_tick --ops-root "$OPS") ;;
esac
if [ "$DRY" = "1" ]; then
  EXTRA=""; [ "$CMD" = "tick" ] && EXTRA=" (only when due_check says due); then: $PY -m cbb_platform.prod.lifecycle quotes (tiered quote refresh + exports)"
  log "DRY RUN: would take $WRITER_LOCK (heavy lock $CBB_HEAVY_LOCK only inside the walk-forward step), run: ${RUN[*]}$EXTRA; duckdb memory_limit $CBB_DUCKDB_MEMORY_LIMIT spill $CBB_DUCKDB_TEMP_DIR"
  exit 0
fi
mkdir -p "$LOCK_DIR"
exec 9>>"$WRITER_LOCK"
flock -w "$WRITER_WAIT_SEC" 9 || { log "CBB writer lock busy > ${WRITER_WAIT_SEC} s; $CMD skipped"; exit 75; }

if [ "$CMD" = "tick" ]; then
  DUE_OUT="$("$PY" cbb_platform/prod/due_check.py "$OPS")"
  log "$(echo "$DUE_OUT" | tr '\n' ' ')"
  RC=0
  if echo "$DUE_OUT" | grep -qx 'due=true'; then
    set +e; "${RUN[@]}"; RC=$?; set -e       # official tick: sync / settlement / the single T-60 official prediction
  fi
  # tiered quote refresh (same writer lock; prod/quote_refresh.py): requests ONLY games due by their tier, reprices the
  # latest persisted PMF (never fits, never simulates), then rebuilds today's Boards (provisional; frozen at the cutoff)
  set +e; "$PY" -m cbb_platform.prod.lifecycle --ops-root "$OPS" --prod-root "$CBB_PROD_ROOT" quotes >/dev/null; QRC=$?; set -e
  [ "$QRC" -eq 0 ] || log "quote refresh / exports failed (rc=$QRC, tick rc=$RC)"
  [ "$RC" -ne 0 ] && exit "$RC"
  exit "$QRC"
fi
exec "${RUN[@]}"
