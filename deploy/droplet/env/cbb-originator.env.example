# /etc/sports-models/cbb-originator.env  (owner root:cbb-originator, mode 0640). TEMPLATE: copy, then fill secrets ON THE
# SERVER ONLY. Never commit a filled copy. This example holds variable NAMES and SAFE DEFAULTS only, never a secret value.
#
# ---- exact verified code (cbb-originator-run refuses any other checkout, or a modified one)
CBB_EXPECTED_COMMIT=
#
# ---- deployment mode: SAFE DEFAULTS. A fresh install must stay like this (docs §10). cbb-originator-run refuses
# ---- (exit 3) any other value of the four flags below; changing them is an explicit, reviewed activation decision.
CBB_MODEL_SOURCE=FROZEN_OPENING_BASELINE
ROTOWIRE_ENABLED=false
ROTOWIRE_RIGHTS_STATUS=UNVERIFIED
WIZARDOFODDS_PUBLICATION=disabled
AUTOMATIC_WAGERING=disabled
REAL_MONEY_ACTIONABILITY=disabled
#
# ---- single writer of the CBB ops state. DISABLED until the cutover step "Droplet timer enabled" (docs §7).
# ---- Any value other than PRIMARY_WRITER makes `morning` and `tick` exit 4 without doing anything.
CBB_SCHEDULER_ROLE=DISABLED
#
# ---- resource gate (docs/walkforward/DROPLET_RESOURCE_REQUIREMENT_CBB.md)
CBB_MIN_MEMAVAILABLE_GB=13
CBB_MEM_WAIT_SEC=1800
CBB_HEAVY_LOCK_WAIT_SEC=1800
CBB_WRITER_LOCK_WAIT_SEC=600
#
# ---- secrets: fill on the server only (names match cbb_platform/credentials.py and the GitHub workflow)
CBBD_API_KEY=
ODDS_API_KEY=
CBB_OPS_ENCRYPTION_KEY=
# fine-grained token: contents read/write on Risky-Scout/cbb-originator ONLY (ops-state branch push + release assets)
GH_TOKEN=
# leave EMPTY while ROTOWIRE_RIGHTS_STATUS=UNVERIFIED (a one-time smoke test does not change the rights status)
ROTOWIRE_API_KEY=
