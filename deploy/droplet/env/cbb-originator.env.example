# /etc/sports-models/cbb-originator.env  (owner root:cbb-originator, mode 0640). TEMPLATE: fill secrets ON THE SERVER
# ONLY. Never commit a filled copy. This example holds variable NAMES and SAFE DEFAULTS only, never a secret value.
# Paths (CBB_APP_ROOT / CBB_PROD_ROOT / CBB_WF_ROOT / CBB_EXPORT_ROOT / CBB_HEAVY_LOCK) are set by the systemd units.
#
# ---- exact verified release (cbb-originator-run refuses any other release, or a modified one)
CBB_EXPECTED_COMMIT=
#
# ---- deployment mode: SAFE DEFAULTS. cbb-originator-run refuses (exit 3) any other value of these flags.
ROTOWIRE_ENABLED=false
# RotoWire acquisition source: DISABLED | API | WEB. WEB = authenticated subscriber web pages (needs ROTOWIRE_ENABLED=true,
# ROTOWIRE_WEB_COOKIE_FILE and a PASS ops/markers/ROTOWIRE_WEB_ACCEPTANCE.json). Never set before live acceptance passes.
ROTOWIRE_SOURCE=DISABLED
WIZARDOFODDS_PUBLICATION=disabled
AUTOMATIC_WAGERING=disabled
REAL_MONEY_ACTIONABILITY=disabled
#
# ---- single writer of the CBB ops state. DISABLED until the cutover step "Droplet timers enabled".
# ---- Any value other than PRIMARY_WRITER makes every scheduled job exit 4 without doing anything.
CBB_SCHEDULER_ROLE=DISABLED
#
# ---- historical source (walkforward/history_source.py). CANDIDATE only after all three equivalence gates PASS.
CBB_HISTORY_SOURCE=CONTROL
CBB_HISTORY_CANDIDATE=
#
# ---- shared heavy lock wait (walk-forward step only) and optional pre-fit MemAvailable floor (MB)
CBB_HEAVY_LOCK_WAIT_SEC=1800
CBB_WRITER_LOCK_WAIT_SEC=600
CBB_MIN_MEMAVAILABLE_MB=
#
# ---- secrets: fill on the server only (names match cbb_platform/credentials.py)
CBBD_API_KEY=
ODDS_API_KEY=
CBB_OPS_ENCRYPTION_KEY=
GH_TOKEN=
# leave EMPTY: RotoWire is HARD_DISABLED_NO_KEY on this deployment
ROTOWIRE_API_KEY=
# PATH (not a secret value) of the protected subscriber session file (cookies.txt or one 'Cookie:' header line), e.g.
# /var/lib/sports-models/cbb-originator/secrets/rotowire_web.cookies  (owner cbb-originator, mode 0600; dir 0700)
ROTOWIRE_WEB_COOKIE_FILE=
