# CBB Originator RotoWire refresh timer, 13:00 America/New_York. TEMPLATE: NOT installed, NOT enabled.
# Exactly four fixed refresh times exist (10:00 / 13:00 / 16:00 / 18:00 ET); per-game cutoffs still decide what may change.
[Unit]
Description=CBB Originator RotoWire refresh 13:00 ET

[Timer]
OnCalendar=*-*-* 13:00:00 America/New_York
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=cbb-originator-lifecycle-refresh@13:00.service

[Install]
WantedBy=timers.target
