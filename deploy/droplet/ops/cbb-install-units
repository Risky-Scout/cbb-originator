#!/bin/bash
# CBB Originator: install the systemd units of the CURRENT release (root). Supersedes /root/cbb_install_units.sh.
# Backs up the installed units to <state>/evidence/unit-backups/<ts> (newest 2 kept; nothing CBB lives in /root), installs every
# changed unit, daemon-reload, re-enables the timers of the release. Never starts a service.
set -euo pipefail
R=/opt/sports-models/cbb-originator/current/deploy/droplet/systemd; E=/etc/systemd/system
UB=/var/lib/sports-models/cbb-originator/evidence/unit-backups; BK=$UB/$(date -u +%Y%m%dT%H%M%SZ); mkdir -p "$BK"
cp -p $E/cbb-originator-* "$BK"/ 2>/dev/null || true
for f in "$R"/*; do n=$(basename "$f"); cmp -s "$f" "$E/$n" || { install -m 0644 "$f" "$E/$n"; echo "installed $n"; }; done
# units the release no longer ships (e.g. 2026-11-18: the 01:30 ET features-warmup timer + service, replaced by the
# morning FEATURE_WARMUP stage): timers are disabled + stopped, then the stale unit files removed (backed up above).
# A stale service that is still active is NEVER stopped or removed here: re-run after it finishes.
for f in $E/cbb-originator-*; do n=$(basename "$f"); [ -f "$f" ] || continue; [ -e "$R/$n" ] && continue
  if [ "${n##*.}" = "timer" ]; then systemctl disable --now "$n" >/dev/null 2>&1 || true; fi
  if systemctl is-active --quiet "$n" 2>/dev/null; then echo "STALE BUT ACTIVE (kept) $n"; continue; fi
  rm -f "$f"; echo "removed stale $n"
done
systemctl daemon-reload
for t in "$R"/*.timer; do systemctl enable "$(basename "$t")" >/dev/null 2>&1; done
for f in "$R"/*; do n=$(basename "$f"); cmp -s "$f" "$E/$n" || echo "STILL DIFFERS $n"; done
ls -1dt "$UB"/*/ 2>/dev/null | tail -n +3 | xargs -r rm -rf
echo "backup: $BK"
systemctl list-timers --all --no-legend 'cbb-originator-*'
