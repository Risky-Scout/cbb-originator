# CBB Originator 07:00 ET daily lifecycle timer. systemd evaluates the zone itself (DST-correct).
[Unit]
Description=CBB Originator 01:30 ET pregame feature-cache warmup timer

[Timer]
OnCalendar=*-*-* 01:30:00 America/New_York
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=cbb-originator-features-warmup.service

[Install]
WantedBy=timers.target
