# CBB Originator 08:00 ET morning recovery timer (replaces the walk-forward-only refit-retry). systemd evaluates the zone.
[Unit]
Description=CBB Originator 08:00 ET morning recovery timer

[Timer]
OnCalendar=*-*-* 08:00:00 America/New_York
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=cbb-originator-morning-recover.service

[Install]
WantedBy=timers.target
