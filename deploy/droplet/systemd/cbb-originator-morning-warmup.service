# CBB Originator morning stage 2/6 FEATURE_WARMUP: after PREP (D-1 sync, settlement, box + identity reconciliation,
# prior-day Grades) and after the 06:00 ET training cutoff, pre-build the immutable per-game pregame feature cache over the
# FROZEN as-of state the walk-forward then fits (same builder). Shared heavy lock (budget CBB_WARMUP_BUDGET_MIN, default
# 150 min); NO CBB writer lock (writes only the walk-forward feature cache + its stage receipt). Advisory: always exits 0;
# the walk-forward keeps its own bounded catch-up as the safety net. Replaces the 01:30 ET standalone warmup, which ran
# before the late D-1 finals existed (2026-11-17/18: walk-forward DEFERRED_FEATURE_BACKLOG, INITIAL on the D-2 model).
# Code: immutable release via /opt/sports-models/cbb-originator/current. State: /var/lib/sports-models/cbb-originator only. No secrets here; never publishes or wagers.
[Unit]
Description=CBB Originator morning stage 2/6: pregame feature warmup (frozen training-cutoff state)
Requires=cbb-originator-morning-prep.service
After=cbb-originator-morning-prep.service
ConditionPathExists=/etc/sports-models/cbb-originator.env

[Service]
Type=oneshot
User=cbb-originator
Group=cbb-originator
SupplementaryGroups=sports-models-heavy
WorkingDirectory=/opt/sports-models/cbb-originator/current
EnvironmentFile=/etc/sports-models/cbb-originator.env
Environment=TZ=America/New_York PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
Environment=OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 NUMEXPR_NUM_THREADS=1
Environment=CBB_DUCKDB_THREADS=1
Environment=CBB_APP_ROOT=/opt/sports-models/cbb-originator/current
Environment=CBB_PROD_ROOT=/var/lib/sports-models/cbb-originator/prod
Environment=CBB_WF_ROOT=/var/lib/sports-models/cbb-originator/walkforward
Environment=CBB_EXPORT_ROOT=/var/lib/sports-models/cbb-originator/exports
Environment=CBB_LOCK_DIR=/var/lib/sports-models/cbb-originator/locks
Environment=CBB_HEAVY_LOCK=/run/lock/sports-models/heavy.lock
Environment=TMPDIR=/var/lib/sports-models/cbb-originator/staging/tmp
ExecStart=/opt/sports-models/cbb-originator/current/deploy/droplet/bin/cbb-originator-run morning-stage warmup
ExecStopPost=/opt/sports-models/cbb-originator/current/deploy/droplet/bin/cbb-originator-run morning-finalize warmup
Restart=no
TimeoutStartSec=170min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cbb-originator-morning-warmup
MemoryHigh=2800M
MemoryMax=3200M
MemorySwapMax=0
Nice=10
CPUQuota=100%
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027
ReadOnlyPaths=/opt/sports-models/cbb-originator
ReadWritePaths=/var/lib/sports-models/cbb-originator /run/lock/sports-models
InaccessiblePaths=-/opt/nba-prop-runtime -/srv/nba-production -/var/lib/nba-prop -/etc/nba-prop-quant
