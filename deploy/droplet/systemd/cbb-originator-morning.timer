# CBB Originator 07:00 ET daily lifecycle timer. systemd evaluates the zone itself (DST-correct).
[Unit]
Description=CBB Originator 07:00 ET daily lifecycle timer

[Timer]
OnCalendar=*-*-* 07:00:00 America/New_York
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=cbb-originator-morning.service

[Install]
WantedBy=timers.target
