# CBB Originator 08:00 ET walk-forward retry timer. systemd evaluates the zone itself (DST-correct).
[Unit]
Description=CBB Originator 08:00 ET walk-forward retry timer

[Timer]
OnCalendar=*-*-* 08:00:00 America/New_York
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=cbb-originator-refit-retry.service

[Install]
WantedBy=timers.target
