# CBB Originator: 09:15 ET prospective selection audit (prod/selection_audit.py daily) -- unattended accumulation of the
# frozen candidate-offer sets, the four pre-declared selection rules, closes, grades, CLV and proper scores against the
# frozen PROPOSED_VALIDATION_GATE_V1. Research output only: never on the decision path, never changes actionability.
# Read-only on the CBB state; writes only /var/lib/sports-models/cbb-originator/audit (audit/selection). No writer lock,
# NEVER the shared heavy lock; no provider call, refit or simulation. Incremental by slate (one slate's quotes in memory).
# Code: immutable release via /opt/sports-models/cbb-originator/current. No secrets here; never publishes or wagers.
[Unit]
Description=CBB Originator 09:15 ET prospective selection audit (read-only)
ConditionPathExists=/etc/sports-models/cbb-originator.env

[Service]
Type=oneshot
User=cbb-originator
Group=cbb-originator
WorkingDirectory=/opt/sports-models/cbb-originator/current
EnvironmentFile=/etc/sports-models/cbb-originator.env
Environment=TZ=America/New_York PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
Environment=CBB_GAME_MODEL=SHADOW
Environment=OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 NUMEXPR_NUM_THREADS=1
Environment=CBB_DUCKDB_THREADS=1
Environment=CBB_APP_ROOT=/opt/sports-models/cbb-originator/current
Environment=CBB_PROD_ROOT=/var/lib/sports-models/cbb-originator/prod
Environment=CBB_WF_ROOT=/var/lib/sports-models/cbb-originator/walkforward
Environment=CBB_EXPORT_ROOT=/var/lib/sports-models/cbb-originator/exports
Environment=CBB_LOCK_DIR=/var/lib/sports-models/cbb-originator/locks
Environment=TMPDIR=/var/lib/sports-models/cbb-originator/audit
ExecStart=/opt/sports-models/cbb-originator/current/deploy/droplet/bin/cbb-originator-run selection-audit
Restart=no
TimeoutStartSec=30min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cbb-originator-selection-audit
MemoryHigh=600M
MemoryMax=800M
MemorySwapMax=0
Nice=10
CPUQuota=100%
CPUWeight=20
IOSchedulingClass=idle
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027
ReadOnlyPaths=/opt/sports-models/cbb-originator
ReadOnlyPaths=/var/lib/sports-models/cbb-originator
ReadWritePaths=/var/lib/sports-models/cbb-originator/audit
InaccessiblePaths=-/opt/nba-prop-runtime -/srv/nba-production -/var/lib/nba-prop -/etc/nba-prop-quant
