# CBB Originator shadow-tick timer. TEMPLATE: NOT installed, NOT enabled. Enable ONLY at cutover, AFTER the GitHub
# scheduled writer is disabled and verified disabled (exactly one writer; docs/operations/CBB_DROPLET_DEPLOYMENT_PACKAGE.md §7).
# The cadence is the architect-approved GitHub cron, copied exactly and kept in UTC so it is identical.
# 12,42 12-23,0-4 * 11,12,1,2,3 *  |  12,42 12-23,0-4 1-8 4 *  |  34 6,9 * 11,12,1,2,3 *  |  34 */6 * 4-10 *
[Unit]
Description=CBB Originator prospective shadow tick timer

[Timer]
OnCalendar=*-11,12,01,02,03-* 00..04,12..23:12,42:00 UTC
OnCalendar=*-04-01..08 00..04,12..23:12,42:00 UTC
OnCalendar=*-11,12,01,02,03-* 06,09:34:00 UTC
OnCalendar=*-04..10-* 00,06,12,18:34:00 UTC
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=cbb-originator-tick.service

[Install]
WantedBy=timers.target
