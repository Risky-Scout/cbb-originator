# CBB Originator 07:00 ET morning stage 2/5 WALK_FORWARD: PIT legality, feature catch-up, fit 1, fit 2, deterministic
# repeat gate, hard gates, atomic promotion / incumbent retention, durable receipt. THE ONLY CBB unit that takes the
# shared heavy lock. Its process exits (memory reclaimed with this cgroup) before the forecast stage starts.
# Code: immutable release via /opt/sports-models/cbb-originator/current. State: /var/lib/sports-models/cbb-originator only. No secrets here; never publishes or wagers.
[Unit]
Description=CBB Originator morning stage 2/5: daily walk-forward
Requires=cbb-originator-morning-prep.service
After=cbb-originator-morning-prep.service
ConditionPathExists=/etc/sports-models/cbb-originator.env

[Service]
Type=oneshot
User=cbb-originator
Group=cbb-originator
SupplementaryGroups=sports-models-heavy
WorkingDirectory=/opt/sports-models/cbb-originator/current
EnvironmentFile=/etc/sports-models/cbb-originator.env
Environment=TZ=America/New_York PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
Environment=OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 NUMEXPR_NUM_THREADS=1
Environment=CBB_DUCKDB_THREADS=1
# glibc heap retention (measured 2026-11-13, standalone 11-13 replay, clean process: VmHWM 3081 -> 2856 MiB; every model
# artifact byte-identical to production). Allocation placement only, never values.
Environment=MALLOC_MMAP_THRESHOLD_=131072 MALLOC_TRIM_THRESHOLD_=131072 MALLOC_ARENA_MAX=2
Environment=CBB_APP_ROOT=/opt/sports-models/cbb-originator/current
Environment=CBB_PROD_ROOT=/var/lib/sports-models/cbb-originator/prod
Environment=CBB_WF_ROOT=/var/lib/sports-models/cbb-originator/walkforward
Environment=CBB_EXPORT_ROOT=/var/lib/sports-models/cbb-originator/exports
Environment=CBB_LOCK_DIR=/var/lib/sports-models/cbb-originator/locks
Environment=CBB_HEAVY_LOCK=/run/lock/sports-models/heavy.lock
Environment=TMPDIR=/var/lib/sports-models/cbb-originator/staging/tmp
ExecStart=/opt/sports-models/cbb-originator/current/deploy/droplet/bin/cbb-originator-run morning-stage walkforward
ExecStopPost=/opt/sports-models/cbb-originator/current/deploy/droplet/bin/cbb-originator-run morning-finalize walkforward
Restart=no
TimeoutStartSec=150min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cbb-originator-walkforward
MemoryHigh=2800M
MemoryMax=3200M
MemorySwapMax=0
Nice=10
CPUQuota=100%
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027
ReadOnlyPaths=/opt/sports-models/cbb-originator
ReadWritePaths=/var/lib/sports-models/cbb-originator /run/lock/sports-models
InaccessiblePaths=-/opt/nba-prop-runtime -/srv/nba-production -/var/lib/nba-prop -/etc/nba-prop-quant
