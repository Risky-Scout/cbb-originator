+# ----------------------------------------------------------------------------- one-time 2025-26 opening
+# docs/LOCKBOX_OPENING_PROTOCOL.md §2.2 (reviewed guard change). Fail closed: 2025-26 is allowed ONLY when ALL hold:
+#   1. OPEN_DECISION_SHA256 below is set by the reviewed opening commit (None = closed, the state of every other commit);
+#   2. the committed decision record at OPEN_DECISION_PATH hashes to exactly that value, is decision_type LOCKBOX_OPEN,
+#      has lockbox_open = true and at least one approver;
+#   3. the session sets LOCKBOX_OPEN_2025_26=1 (a flag alone never opens it: LOCKBOX_POLICY.md §4);
+#   4. the provider is CBBD (or the canonical/Stage 3 readers) and the endpoint is in the frozen data plan.
+# Seasons after 2025-26 stay refused.
+OPEN_DECISION_PATH = Path(__file__).resolve().parents[1] / "data" / "manifests" / "LOCKBOX_OPEN_DECISION_2025_26.json"
+OPEN_DECISION_SHA256: str | None = None
+OPEN_PLAN_ENDPOINTS = frozenset({"games", "games/players", "games/teams", "teams/roster", "substitutions/team",
+                                 "stats/player/season", "recruiting/players", "recruiting/portal"})   # frozen data plan
+
+
+def opening_authorized(provider: str = "canonical", endpoint: str | None = None) -> bool:
+    if OPEN_DECISION_SHA256 is None or os.environ.get("LOCKBOX_OPEN_2025_26") != "1":
+        return False
+    if provider not in ("cbbd", "canonical") or (endpoint is not None and endpoint not in OPEN_PLAN_ENDPOINTS):
+        return False
+    try:
+        raw = OPEN_DECISION_PATH.read_bytes()
+    except OSError:
+        return False
+    if hashlib.sha256(raw).hexdigest() != OPEN_DECISION_SHA256:
+        return False
+    rec = json.loads(raw)
+    return rec.get("decision_type") == "LOCKBOX_OPEN" and rec.get("lockbox_open") is True and bool(rec.get("approved_by"))
+
+
+def check_season(season, provider: str = "canonical", endpoint: str | None = None) -> None:
+    if season is not None and canonical_season(provider, season) == LOCKBOX_SEASON \
+            and not opening_authorized(provider, endpoint):
         raise LockboxViolation(f"LOCKBOX: {provider} season {season} is {LOCKBOX_LABEL}, the frozen holdout")
 
 
+def _refuse_unless_opened(provider: str, s: int, opened: bool) -> None:
+    """2025-26 passes only when THIS request's provider and endpoint are authorized (never via the canonical default)."""
+    if s == LOCKBOX_SEASON and not opened:
+        raise LockboxViolation(f"LOCKBOX: {provider} season {s} is {LOCKBOX_LABEL}, the frozen holdout")
+
